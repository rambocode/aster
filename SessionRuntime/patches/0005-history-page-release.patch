+/// Allocation-free reset for direct page backing. All discarded buffers are
+/// returned immediately; retained buffers remain active-screen allocations.
+fn resetDirectPages(self: *PageList) void {
+    var remaining = self.rows;
+    var it = self.pages.first;
+    while (it) |node| {
+        const next = node.next;
+        if (remaining == 0) {
+            self.pages.remove(node);
+            self.destroyNode(node);
+        } else {
+            node.data.reinit();
+            // Non-reflow shrink preserves capacity.cols; reinit restores that
+            // capacity, so restore the current logical width explicitly.
+            node.data.size.cols = self.cols;
+            node.data.size.rows = @min(remaining, node.data.capacity.rows);
+            remaining -= node.data.size.rows;
+            node.serial = self.page_serial;
+            self.page_serial += 1;
+        }
+        it = next;
+    }
+    assert(remaining == 0);
+    self.page_serial_min = self.pages.first.?.serial;
+    self.total_rows = self.rows;
+    for (self.tracked_pins.keys()) |pin_| {
+        pin_.node = self.pages.first.?;
+        pin_.x = 0;
+        pin_.y = 0;
+        pin_.garbage = true;
+    }
+    self.viewport_pin.garbage = false;
+    self.viewport = .active;
+}
