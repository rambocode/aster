+test "PageList library page backing bypasses spare arena and reset reuses buffers" {
+    const testing = std.testing;
+    if (!direct_pages) return error.SkipZigTest;
+    var list = try PageList.init(testing.allocator, 80, 3, 16 * 1024 * 1024);
+    defer list.deinit();
+    for (0..1000) |_| _ = try list.grow();
+    try testing.expect(list.pages.first != list.pages.last);
+    try testing.expect(list.pool.pages.arena.state.buffer_list.first == null);
+    list.eraseHistory(null);
+    try testing.expectEqual(@as(usize, list.rows), list.total_rows);
+    try testing.expect(list.pool.pages.arena.state.buffer_list.first == null);
+    for (0..1000) |_| _ = try list.grow();
+    list.reset();
+    try testing.expectEqual(@as(usize, list.rows), list.total_rows);
+    try testing.expect(list.pool.pages.arena.state.buffer_list.first == null);
+    list.reset();
+    try testing.expectEqual(@as(usize, list.rows), list.total_rows);
+}
+
+test "PageList library direct page allocations are released through destroyNodeExt" {
+    const testing = std.testing;
+    if (!direct_pages) return error.SkipZigTest;
+    // Testing allocator catches mismatched frees and leaked direct allocations,
+    // unlike the native page allocator used by production PageList.init.
+    var pool = try MemoryPool.init(testing.allocator, testing.allocator, 8);
+    defer pool.deinit();
+    var serial: u64 = 0;
+    const initialized = try initPages(&pool, &serial, 80, 100);
+    var nodes = initialized[0];
+    var bytes = initialized[1];
+    try testing.expect(bytes > 0);
+    try testing.expect(pool.pages.arena.state.buffer_list.first == null);
+    while (nodes.popFirst()) |node| destroyNodeExt(&pool, node, &bytes);
+    try testing.expectEqual(@as(usize, 0), bytes);
+    try testing.expect(pool.pages.arena.state.buffer_list.first == null);
+}
+
+test "PageList library reset preserves resized geometry accounting and tracked pins" {
+    const testing = std.testing;
+    if (!direct_pages) return error.SkipZigTest;
+    for ([_]bool{ false, true }) |reflow| {
+        for ([_][2]size.CellCountInt{ .{ 80, 10 }, .{ 10, 120 } }) |columns| {
+            var list = try PageList.init(testing.allocator, columns[0], 3, 16 * 1024 * 1024);
+            defer list.deinit();
+            for (0..1000) |_| _ = try list.grow();
+            const tracked = try list.trackPin(list.pin(.{ .active = .{ .x = 1, .y = 1 } }).?);
+            defer list.untrackPin(tracked);
+            try list.resize(.{ .cols = columns[1], .rows = 5, .reflow = reflow });
+            const before_bytes = list.page_size;
+            list.reset();
+            try testing.expectEqual(columns[1], list.cols);
+            try testing.expectEqual(@as(size.CellCountInt, 5), list.rows);
+            try testing.expectEqual(@as(usize, 5), list.total_rows);
+            var bytes: usize = 0;
+            var rows: usize = 0;
+            var it = list.pages.first;
+            while (it) |node| : (it = node.next) {
+                try testing.expectEqual(list.cols, node.data.size.cols);
+                try testing.expect(node.data.size.rows > 0);
+                bytes += node.data.memory.len;
+                rows += node.data.size.rows;
+            }
+            try testing.expectEqual(@as(usize, 5), rows);
+            try testing.expectEqual(bytes, list.page_size);
+            try testing.expect(bytes <= before_bytes);
+            try testing.expect(tracked.node == list.pages.first.?);
+            try testing.expectEqual(@as(size.CellCountInt, 0), tracked.x);
+            try testing.expectEqual(@as(size.CellCountInt, 0), tracked.y);
+            try testing.expect(tracked.garbage);
+            try testing.expect(list.viewport_pin.node == list.pages.first.?);
+            try testing.expect(!list.viewport_pin.garbage);
+            try testing.expect(list.viewport == .active);
+            try testing.expect(list.pool.pages.arena.state.buffer_list.first == null);
+        }
+    }
