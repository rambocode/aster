     removed.* = before.rows - out.rows;
     return .success;
 }
+
+/// Serial is stable within this Screen's PageList lifetime and changes when a
+/// pooled node is reused. Consumers must clear identities on screen replacement
+/// and must never compare serials belonging to different terminals/screens.
+pub const AsterHistoryPage = extern struct {
+    serial: u64,
+    first_row: usize,
+    rows: usize,
+    charged_bytes: usize,
+};
+
+pub fn aster_history_pages(terminal_: terminal_c.Terminal, screen_id: u32, out: ?[*]AsterHistoryPage, capacity: usize, written: *usize) callconv(lib.calling_conv) Result {
+    written.* = 0;
+    const terminal = (terminal_ orelse return .invalid_value).terminal;
+    const key: @import("../ScreenSet.zig").Key = switch (screen_id) {
+        0 => .primary, 1 => .alternate, else => return .invalid_value,
+    };
+    const screen = terminal.screens.get(key) orelse return .no_value;
+    if (screen.pages.total_rows == screen.pages.rows) return .success;
+    var row: usize = 0;
+    var it = screen.pages.pageIterator(.right_down, .{ .history = .{} }, null);
+    while (it.next()) |chunk| {
+        const rows: usize = chunk.end - chunk.start;
+        if (out) |buffer| {
+            if (written.* < capacity) buffer[written.*] = .{
+                .serial = chunk.node.serial,
+                .first_row = row,
+                .rows = rows,
+                .charged_bytes = chunk.node.data.memory.len,
+            };
+        }
+        written.* += 1;
+        row += rows;
+    }
+    return if (out == null or written.* > capacity) .out_of_space else .success;
+}
