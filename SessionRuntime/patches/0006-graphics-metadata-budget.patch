+
+test "metadata budget eviction releases pins at exact byte boundary" {
+    const a = std.testing.allocator;
+    var t = try terminal.Terminal.init(a, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(a);
+    const screen = t.screens.active;
+    const baseline = screen.pages.countTrackedPins();
+    var storage: ImageStorage = .{ .total_limit = 3, .metadata_limits = .{ .images = 2, .placements = 2 } };
+    defer storage.deinit(a, screen);
+    try storage.addImage(a, screen, .{ .id = 1, .data = try a.dupe(u8, "RGB") });
+    try storage.addPlacement(a, screen, 1, 1, .{ .location = .{ .pin = try trackPin(&t, .{}) } });
+    try storage.addImage(a, screen, .{ .id = 2, .data = try a.dupe(u8, "rgb") });
+    try std.testing.expect(storage.imageById(1) == null);
+    try std.testing.expectEqual(@as(usize, 3), storage.total_bytes);
+    try std.testing.expectEqual(baseline, screen.pages.countTrackedPins());
+    try storage.addPlacement(a, screen, 2, 1, .{ .location = .{ .pin = try trackPin(&t, .{}) } });
+    try storage.setLimit(a, screen, 1);
+    try std.testing.expectEqual(baseline, screen.pages.countTrackedPins());
+}
