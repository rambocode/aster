+    var t = try terminal.Terminal.init(a, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(a);
+    const screen = t.screens.active;
+    const baseline = screen.pages.countTrackedPins();
+    const storage = &screen.kitty_images;
+    storage.metadata_limits = .{ .images = 1, .placements = 1 };
+    try storage.addImage(a, screen, .{ .id = 1, .width = 1, .height = 1 });
+    const display: Command = .{ .control = .{ .display = .{ .image_id = 1, .placement_id = 1, .cursor_movement = .none } } };
+    const exec = @import("graphics_exec.zig").execute;
+    const allocation_failed = exec(std.testing.failing_allocator, &t, &display).?;
+    try std.testing.expect(!allocation_failed.ok());
+    try std.testing.expectEqual(baseline, screen.pages.countTrackedPins());
+    try std.testing.expect(exec(a, &t, &display).?.ok());
+    const rejected: Command = .{ .control = .{ .display = .{ .image_id = 1, .placement_id = 2, .cursor_movement = .none } } };
+    try std.testing.expect(!exec(a, &t, &rejected).?.ok());
+    try std.testing.expectEqual(baseline + 1, screen.pages.countTrackedPins());
