+test "metadata budget replacement releases real and virtual pins" {
+    const a = std.testing.allocator;
+    var t = try terminal.Terminal.init(a, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(a);
+    const screen = t.screens.active;
+    const baseline = screen.pages.countTrackedPins();
+    var storage: ImageStorage = .{ .metadata_limits = .{ .images = 1, .placements = 1 } };
+    defer storage.deinit(a, screen);
+    try storage.addImage(a, screen, .{ .id = 1 });
+    for (0..100) |_| {
+        try storage.addPlacement(a, screen, 1, 1, .{ .location = .{ .pin = try trackPin(&t, .{}) } });
+        try std.testing.expectEqual(baseline + 1, screen.pages.countTrackedPins());
+    }
+    try storage.addPlacement(a, screen, 1, 1, .{ .location = .{ .virtual = {} } });
