+test "metadata budget rejects new keys and permits replacement at capacity" {
+    const a = std.testing.allocator;
+    var t = try terminal.Terminal.init(a, .{ .rows = 3, .cols = 3 });
+    defer t.deinit(a);
+    const screen = t.screens.active;
+    var storage: ImageStorage = .{ .metadata_limits = .{ .images = 1, .placements = 2 } };
+    defer storage.deinit(a, screen);
+    try storage.addImage(a, screen, .{ .id = 1 });
+    try std.testing.expectError(error.OutOfMemory, storage.addImage(a, screen, .{ .id = 2 }));
+    try storage.addImage(a, screen, .{ .id = 1, .width = 2 });
+    try std.testing.expectEqual(@as(u32, 2), storage.imageById(1).?.width);
+    try storage.addPlacement(a, screen, 1, 1, .{ .location = .{ .virtual = {} } });
+    try storage.addPlacement(a, screen, 1, 0, .{ .location = .{ .virtual = {} } });
+    try std.testing.expectError(error.OutOfMemory, storage.addPlacement(a, screen, 1, 0, .{ .location = .{ .virtual = {} } }));
+    try std.testing.expectError(error.OutOfMemory, storage.addPlacement(a, screen, 1, 2, .{ .location = .{ .virtual = {} } }));
+    try storage.addPlacement(a, screen, 1, 1, .{ .location = .{ .virtual = {} }, .z = 9 });
