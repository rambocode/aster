+
+/// Re-emits the program's last DECSCUSR request for this screen. Screen
+/// content replay starts from RIS, which drops the cursor shape; without this a
+/// shell whose integration switched the cursor to a bar comes back as the
+/// client's default block until the next prompt is drawn. Screens that never
+/// received DECSCUSR emit nothing so the client keeps its configured default.
+fn cursorShape(screen: *const @import("../Screen.zig"), writer: *std.Io.Writer) std.Io.Writer.Error!void {
+    const req = screen.cursor.cursor_style_req orelse return;
+    const code: u8 = switch (req) {
+        .default => 0,
+        .blinking_block => 1,
+        .steady_block => 2,
+        .blinking_underline => 3,
+        .steady_underline => 4,
+        .blinking_bar => 5,
+        .steady_bar => 6,
+    };
+    try writer.print("\x1b[{d} q", .{code});
 }
 
