+/// Scroll to an absolute row in the currently retained screen. The PageList
+/// clamps rows above or below the valid range to its top/active viewport.
+pub fn asterScrollToRow(self: *Surface, row: usize) bool {
+    self.renderer_state.mutex.lock();
+    // Screen.scroll (not PageList.scroll) so a fractional row is cleared too.
+    self.io.terminal.screens.active.scroll(.{ .row = row });
+    self.renderer_state.mutex.unlock();
+    self.queueRender() catch |err| {
+        log.warn("Aster viewport render failed err={}", .{err});
+        return false;
+    };
+    return true;
+}
