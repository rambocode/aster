+test "Screen: Aster scroll delta_f" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 10, .rows = 3, .max_scrollback = 10_000 });
+    defer s.deinit();
+    try s.testWriteString("A\nB\nC\nD\nE\nF\nG");
+
+    try testing.expect(s.viewportIsBottom());
+    const max_off = s.pages.scrollbar().offset;
+    try testing.expect(max_off >= 3);
+
+    // Scrolling down at the bottom stays at the bottom, row-aligned.
+    s.scroll(.{ .delta_f = 1 });
