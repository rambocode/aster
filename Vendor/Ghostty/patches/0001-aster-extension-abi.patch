+/// Aster extension entrypoint for setting or clearing an exact terminal
+/// selection. The caller constructs untracked pins while holding no locks;
+/// `Screen.select` converts them to tracked pins before this method returns.
+pub fn asterSetSelection(self: *Surface, sel: ?terminal.Selection) bool {
+    self.renderer_state.mutex.lock();
+    defer self.renderer_state.mutex.unlock();
+
+    return self.asterSetSelectionLocked(sel);
+}
+
+/// Variant for the embedded ABI after it has resolved stable page anchors
+/// while already holding the renderer mutex.
+pub fn asterSetSelectionLocked(self: *Surface, sel: ?terminal.Selection) bool {
+    self.setSelection(sel) catch |err| {
+        log.warn("Aster selection update failed err={}", .{err});
+        return false;
+    };
+    self.io.terminal.screens.active.dirty.selection = true;
+    self.queueRender() catch |err| {
+        log.warn("Aster selection render failed err={}", .{err});
+    };
+    return true;
