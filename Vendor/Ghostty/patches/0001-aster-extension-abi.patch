+/// Streaming OSC scanner used only by the Aster extension ABI. Ghostty's
+/// parser still receives every original byte; malformed and over-limit OSCs
+/// are dropped only from this observer channel.
+const AsterOSCScanner = struct {
+    const max_payload_len = 64 * 1024;
+
+    const State = enum {
+        ground,
+        escape,
+        code,
+        payload,
+        payload_escape,
+        discard,
+        discard_escape,
+    };
+
+    state: State = .ground,
+    code: u32 = 0,
+    has_code: bool = false,
+    payload: [max_payload_len]u8 = undefined,
+    payload_len: usize = 0,
+    utf8_continuations: u3 = 0,
+
+    const Event = struct { code: u32, payload: []const u8 };
+
+    fn init(_: termio.Options.AsterObserver) AsterOSCScanner { return .{}; }
+
+    fn reset(self: *AsterOSCScanner) void {
+        self.state = .ground;
+        self.code = 0;
+        self.has_code = false;
+        self.payload_len = 0;
+        self.utf8_continuations = 0;
+    }
+
+    fn begin(self: *AsterOSCScanner) void {
+        self.state = .code;
+        self.code = 0;
+        self.has_code = false;
+        self.payload_len = 0;
+        self.utf8_continuations = 0;
+    }
+
+    fn emit(self: *AsterOSCScanner) ?Event {
+        const event: ?Event = if (self.has_code)
+            .{ .code = self.code, .payload = self.payload[0..self.payload_len] }
+        else
+            null;
+        self.reset();
+        return event;
+    }
+
+    fn append(self: *AsterOSCScanner, byte: u8) void {
+        if (self.payload_len >= self.payload.len) {
+            self.state = .discard;
+            return;
+        }
+        self.payload[self.payload_len] = byte;
+        self.payload_len += 1;
+    }
+
+    fn next(self: *AsterOSCScanner, byte: u8) ?Event {
+        return switch (self.state) {
+            .ground => {
+                // Avoid interpreting UTF-8 continuation byte 0x9D as C1 OSC.
+                if (self.utf8_continuations > 0) {
+                    if (byte & 0xC0 == 0x80) self.utf8_continuations -= 1 else self.utf8_continuations = 0;
+                    return null;
+                }
+                self.utf8_continuations = switch (byte) {
+                    0xC2...0xDF => 1,
+                    0xE0...0xEF => 2,
+                    0xF0...0xF4 => 3,
+                    else => 0,
+                };
+                if (byte == 0x1B) self.state = .escape else if (byte == 0x9D) self.begin();
+                return null;
+            },
+            .escape => {
+                if (byte == ']') self.begin() else if (byte != 0x1B) self.state = .ground;
+                return null;
+            },
+            .code => switch (byte) {
+                '0'...'9' => {
+                    self.has_code = true;
+                    self.code = self.code *| 10 +| byte - '0';
+                    return null;
+                },
+                ';' => if (self.has_code) {
+                    self.state = .payload;
+                    return null;
+                } else {
+                    self.state = .discard;
+                    return null;
+                },
+                0x07, 0x9C => return self.emit(),
+                0x1B => { self.state = .payload_escape; return null; },
+                else => { self.state = .discard; return null; },
+            },
+            .payload => {
+                // 0x9C is also a UTF-8 continuation byte (e.g. U+2733 "✳" is
+                // E2 9C B3). Only treat it as a C1 ST terminator when we are
+                // not inside a multibyte sequence, mirroring the ground state.
+                if (self.utf8_continuations > 0) {
+                    if (byte & 0xC0 == 0x80) {
+                        self.utf8_continuations -= 1;
+                        self.append(byte);
+                        return null;
+                    }
+                    self.utf8_continuations = 0;
+                }
+                switch (byte) {
+                    0x07, 0x9C => return self.emit(),
+                    0x1B => {
+                        self.state = .payload_escape;
+                        return null;
+                    },
+                    else => {
+                        self.utf8_continuations = switch (byte) {
+                            0xC2...0xDF => 1,
+                            0xE0...0xEF => 2,
+                            0xF0...0xF4 => 3,
+                            else => 0,
+                        };
+                        self.append(byte);
+                        return null;
+                    },
+                }
+            },
+            .payload_escape => if (byte == '\\') {
+                return self.emit();
+            } else {
+                self.append(0x1B);
+                if (self.state != .discard) {
+                    self.append(byte);
+                    if (self.state != .discard) self.state = .payload;
+                }
+                return null;
+            },
+            .discard => switch (byte) {
+                0x07, 0x9C => { self.reset(); return null; },
+                0x1B => { self.state = .discard_escape; return null; },
+                else => return null,
+            },
+            .discard_escape => {
+                if (byte == '\\') self.reset() else if (byte != 0x1B) self.state = .discard;
+                return null;
+            },
+        };
+    }
+};
