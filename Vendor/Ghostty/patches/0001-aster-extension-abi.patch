+
+test "Aster OSC observer keeps UTF-8 continuation byte 0x9C inside payload" {
+    var scanner: AsterOSCScanner = .init(.{
+        .osc = null,
+    });
+
+    // "✳ hi" 的 U+2733 编码为 E2 9C B3；0x9C 不得被当作 ST 提前终止 OSC 0 标题。
+    for ("\x1b]0;") |byte| try std.testing.expect(scanner.next(byte) == null);
+    for (&[_]u8{ 0xE2, 0x9C, 0xB3, ' ', 'h', 'i' }) |byte|
+        try std.testing.expect(scanner.next(byte) == null);
+    const event = scanner.next(0x07).?;
+    try std.testing.expectEqual(@as(u32, 0), event.code);
+    try std.testing.expectEqualStrings("\xE2\x9C\xB3 hi", event.payload);
+
+    // 序列结束后 0x9C 恢复 ST 语义。
+    for ("\x1b]2;ab") |byte| try std.testing.expect(scanner.next(byte) == null);
+    const second = scanner.next(0x9C).?;
+    try std.testing.expectEqual(@as(u32, 2), second.code);
+    try std.testing.expectEqualStrings("ab", second.payload);
+}
