+/// Aster: fractional part of the viewport's scroll row, `0 <= value < 1`.
+pub fn asterScrollRowFrac(self: *Surface) f64 {
+    self.renderer_state.mutex.lock();
+    defer self.renderer_state.mutex.unlock();
+    return self.io.terminal.scrollRowFrac();
+}
+
+/// Aster: scroll the primary screen's scrollback by a fractional number of
+/// rows (up is negative). The alternate screen has no scrollback, so the
+/// call is a no-op there. Returns the resulting fractional row.
+pub fn asterScrollRowsFractional(self: *Surface, delta_rows: f64) f64 {
+    self.renderer_state.mutex.lock();
+    const t: *terminal.Terminal = self.renderer_state.terminal;
+    if (t.screens.active_key == .primary) t.scrollViewportFractional(delta_rows);
+    const frac = t.scrollRowFrac();
+    self.renderer_state.mutex.unlock();
+    self.queueRender() catch |err| log.warn("Aster viewport render failed err={}", .{err});
+    return frac;
+}
+
+/// Aster: round a fractional scroll position to the nearest whole row.
+pub fn asterSnapScrollRow(self: *Surface) void {
+    self.renderer_state.mutex.lock();
+    const changed = self.io.terminal.snapScrollRow();
+    self.renderer_state.mutex.unlock();
+    if (changed) self.queueRender() catch |err| log.warn("Aster viewport render failed err={}", .{err});
