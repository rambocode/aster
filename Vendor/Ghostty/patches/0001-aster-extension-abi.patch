+pub const AsterSearchResult = struct {
+    screen: *terminal.Screen,
+    selection: ?terminal.Selection,
+    /// One-based match index for direct display as `N / M`.
+    selected: u64,
+    total: u64,
+};
+
+/// Search the complete retained buffer and select the requested match. Search
+/// uses Ghostty's byte-to-pin map, preserving exact cell coordinates across
+/// Unicode and wrapped rows. Empty matches are ignored because they cannot be
+/// represented as a terminal cell selection.
+pub fn asterSearch(
+    self: *Surface,
+    pattern: []const u8,
+    opts: AsterSearchOptions,
+) !AsterSearchResult {
+    self.renderer_state.mutex.lock();
+    defer self.renderer_state.mutex.unlock();
+
+    const screen = self.io.terminal.screens.active;
+    const all = screen.selectAll() orelse return .{
+        .screen = screen,
+        .selection = null,
+        .selected = 0,
+        .total = 0,
+    };
+
+    var string_map: terminal.StringMap = undefined;
+    const text = try screen.selectionString(self.alloc, .{
+        .sel = all,
+        .trim = false,
+        .map = &string_map,
+    });
+    self.alloc.free(text);
+    defer string_map.deinit(self.alloc);
+
+    var regex = oni.Regex.init(
+        pattern,
+        .{
+            .ignorecase = !opts.case_sensitive,
+            .find_not_empty = true,
+        },
+        oni.Encoding.utf8,
+        if (opts.regular_expression) oni.Syntax.default else oni.Syntax.asis,
+        null,
+    ) catch return error.InvalidSearchPattern;
+    defer regex.deinit();
+
+    const current = screen.selection;
+    const current_start = if (current) |sel|
+        screen.pages.pointFromPin(.screen, sel.topLeft(screen)).?.screen
+    else
+        null;
+    const current_end = if (current) |sel|
+        screen.pages.pointFromPin(.screen, sel.bottomRight(screen)).?.screen
+    else
+        null;
+
+    const Candidate = struct { selection: terminal.Selection, index: u64 };
+    var first: ?Candidate = null;
+    var last: ?Candidate = null;
+    var forward: ?Candidate = null;
+    var backward: ?Candidate = null;
+    var total: u64 = 0;
+    var iterator = string_map.searchIterator(regex);
+    while (try iterator.next()) |match_value| {
+        var match = match_value;
+        defer match.deinit();
+        const selection = match.selection();
+        total += 1;
+        const candidate: Candidate = .{ .selection = selection, .index = total };
+        if (first == null) first = candidate;
+        last = candidate;
+
+        const start = screen.pages.pointFromPin(.screen, selection.topLeft(screen)).?.screen;
+        const end = screen.pages.pointFromPin(.screen, selection.bottomRight(screen)).?.screen;
+        if (current_end) |reference| {
+            if (forward == null and asterPointAfter(start, reference)) forward = candidate;
+        }
+        if (current_start) |reference| {
+            if (asterPointBefore(end, reference)) backward = candidate;
+        }
+    }
+
+    const chosen = if (opts.backwards)
+        (backward orelse last)
+    else
+        (forward orelse first);
+    if (chosen) |value| {
+        self.setSelection(value.selection) catch return error.OutOfMemory;
+        screen.dirty.selection = true;
+        self.queueRender() catch |err| log.warn("Aster search render failed err={}", .{err});
+        return .{
+            .screen = screen,
+            .selection = value.selection,
+            .selected = value.index,
+            .total = total,
+        };
+    }
+
+    return .{ .screen = screen, .selection = null, .selected = 0, .total = total };
+}
+
+fn asterPointBefore(lhs: terminal.point.Coordinate, rhs: terminal.point.Coordinate) bool {
+    return lhs.y < rhs.y or (lhs.y == rhs.y and lhs.x < rhs.x);
+}
+
+fn asterPointAfter(lhs: terminal.point.Coordinate, rhs: terminal.point.Coordinate) bool {
+    return lhs.y > rhs.y or (lhs.y == rhs.y and lhs.x > rhs.x);
+}
