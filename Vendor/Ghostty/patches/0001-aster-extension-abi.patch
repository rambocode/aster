+    var payload: [AsterOSCScanner.max_payload_len + 1]u8 = @splat('x');
+    for (&payload) |byte| try std.testing.expect(scanner.next(byte) == null);
+    try std.testing.expect(scanner.next(0x07) == null);
+
+    try std.testing.expectEqual(AsterOSCScanner.State.ground, scanner.state);
