+    /// associated with their leading cell; Aster only needs the base codepoint
+    /// and width marker for exact navigation and selection coordinates.
+    export fn ghostty_aster_surface_read_cells(
+        surface: *Surface,
+        row: u64,
+        cells: [*]AsterCell,
+        capacity: usize,
+    ) usize {
+        const screen_row = std.math.cast(u32, row) orelse return 0;
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        const start = screen.pages.pin(.{ .screen = .{ .x = 0, .y = screen_row } }) orelse return 0;
+        const row_and_cell = start.rowAndCell();
+        const source = start.node.data.getCells(row_and_cell.row);
+        const count = @min(capacity, source.len);
+        for (source[0..count], cells[0..count]) |cell, *result| {
+            result.* = .{
+                .codepoint = if (cell.hasText()) cell.codepoint() else 0,
+                .width = switch (cell.wide) {
+                    .narrow => 1,
+                    .wide => 2,
+                    .spacer_tail, .spacer_head => 0,
+                },
+                .has_text = cell.hasText(),
+            };
+        }
+        return count;
+    }
+
+    /// Search the retained primary or alternate screen with exact terminal
+    /// coordinates. The core owns pattern parsing and byte-to-cell mapping so
+    /// regex matches cannot drift from rendered grapheme cells.
+    export fn ghostty_aster_surface_search(
+        surface: *Surface,
+        pattern_ptr: [*]const u8,
+        pattern_len: usize,
+        flags: u32,
+        result: *AsterSearchResult,
+    ) bool {
+        const empty_point: AsterBufferPoint = .{
+            .column = 0,
+            .screen_row = 0,
+            .page_serial = 0,
+            .page_row = 0,
+        };
+        result.* = .{
+            .pattern_valid = true,
+            .found = false,
+            .selected = 0,
+            .total = 0,
+            .match = .{ .start = empty_point, .end = empty_point, .rectangle = false },
+        };
+        if (pattern_len == 0) return true;
+
+        const search = surface.core_surface.asterSearch(
+            pattern_ptr[0..pattern_len],
+            .{
+                .case_sensitive = flags & 1 != 0,
+                .regular_expression = flags & 2 != 0,
+                .backwards = flags & 4 != 0,
+            },
+        ) catch |err| switch (err) {
+            error.InvalidSearchPattern => {
+                result.pattern_valid = false;
+                return false;
+            },
+            else => {
+                log.warn("Aster terminal search failed err={}", .{err});
+                return false;
+            },
+        };
+        result.total = search.total;
+        const selected = search.selection orelse return true;
+        result.found = true;
+        result.selected = search.selected;
+        result.match = .{
+            .start = AsterBufferPoint.fromPin(search.screen, selected.start()) orelse return false,
+            .end = AsterBufferPoint.fromPin(search.screen, selected.end()) orelse return false,
+            .rectangle = selected.rectangle,
+        };
+        return true;
+    }
+
