+fn notifyAsterOSC(self: *Termio, event: AsterOSCScanner.Event) void {
+    const screen = self.terminal.screens.active;
+    const pin = screen.cursor.page_pin.*;
+    const point = screen.pages.pointFromPin(.screen, pin) orelse return;
+    self.aster_observer.notifyOSC(event.code, event.payload, .{
+        .column = pin.x,
+        .screen_row = point.screen.y,
+        .page_serial = pin.node.serial,
+        .page_row = pin.y,
+    });
+}
